{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "eye-guard",
  "version": "0.1.4",
  "identifier": "com.zhuchentong.eye-guard",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "eye-guard",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ws://localhost:1420 http://localhost:1420 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2RDA5NkVENERBOTExM0QKUldROUVhbE43WmJROXA4ci9pdTFER0xCTUxlNUpGd3RFS3VSU2VmVzd1VlNiK1NNNE41YTdmOWkK",
      "endpoints": [
        "https://github.com/zhuchentong/eye-guard/releases/latest/download/latest.json"
      ]
    }
  }
}
